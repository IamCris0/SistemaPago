# .htaccess para API de Mawewe
# Configuración CORS y PHP

# ========================================
# HABILITAR CORS
# ========================================
<IfModule mod_headers.c>
    # Permitir peticiones desde cualquier origen
    Header always set Access-Control-Allow-Origin "*"
    
    # Métodos HTTP permitidos
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    
    # Headers permitidos en las peticiones (✅ MODIFICADO: agregado cache-control)
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, cache-control"
    
    # Permitir credenciales
    Header always set Access-Control-Allow-Credentials "true"
    
    # Cache de preflight por 1 hora
    Header always set Access-Control-Max-Age "3600"
</IfModule>

# ========================================
# RESPONDER A OPTIONS (PREFLIGHT)
# ========================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# ========================================
# HABILITAR PHP
# ========================================
<Files "*.php">
    SetHandler application/x-httpd-php
</Files>

# ========================================
# SEGURIDAD
# ========================================
# Deshabilitar listado de directorios
Options -Indexes

# Bloquear acceso a archivos sensibles
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ========================================
# COMPRESIÓN
# ========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
</IfModule>

# ========================================
# CACHE CONTROL
# ========================================
<IfModule mod_headers.c>
    # No cachear respuestas JSON
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ========================================
# UTF-8 ENCODING
# ========================================
AddDefaultCharset UTF-8