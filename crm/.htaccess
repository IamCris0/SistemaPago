<IfModule mod_headers.c>
    # Permitir origen específico del CRM
    SetEnvIf Origin "^https://spc\.elpalaciodelamorjoyeria\.com$" CORS_ORIGIN=$0
    SetEnvIf Origin "^https://mawewe\.com\.ec$" CORS_ORIGIN=$0

    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Cache-Control"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Responder OPTIONS directamente (preflight)
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]
