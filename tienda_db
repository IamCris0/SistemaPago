CREATE ALGORITHM=UNDEFINED DEFINER=`maweweco_cris`@`45.189.57.40` SQL SECURITY DEFINER VIEW `active_employees_stats`  AS SELECT `e`.`id` AS `id`, `e`.`nombre` AS `nombre`, `e`.`cedula` AS `cedula`, `e`.`cargo` AS `cargo`, `e`.`sucursal` AS `sucursal`, `e`.`is_admin` AS `is_admin`, `e`.`active` AS `active`, `e`.`created_at` AS `created_at`, `e`.`updated_at` AS `updated_at`, count(distinct `att`.`id`) AS `total_attendance`, sum(`att`.`hours_worked`) AS `total_hours_worked` FROM (`employees` `e` left join `attendance` `att` on(`e`.`id` = `att`.`employee_id`)) WHERE `e`.`active` = 1 GROUP BY `e`.`id` ;

