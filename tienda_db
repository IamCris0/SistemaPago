(130, 'PER-HOM-001', 'Perfume ferrari', 'perfumes', 'hombre', 30.00, 'Perfume con gran fragancia.', 'images/productos/perfumes/PER-HOM-001/PER-HOM-001_1772325685_3635.jpg', '[\"images/productos/perfumes/PER-HOM-001/PER-HOM-001_1772325685_3635.jpg\",\"images/productos/perfumes/PER-HOM-001/PER-HOM-001_1772325688_2638.jpg\"]', 0, 0, '2026-03-01 00:42:02', '2026-03-06 01:30:32'),
(131, 'BEL-VIC-001', 'Victoria\'s Secret Very Sexy Night Eau de Parfum Mini Spray 7.5ml', 'belleza', 'victorias-secret', 130.00, 'Notas de ciruela negra y manzana brillan entre oscuros aromas florales. Maderas aterciopeladas y almizcles sensuales le añaden una profundidad embriagadora. Embriagadora y cálida, esta fragancia Night definitivamente no es para dormir.', 'images/productos/belleza/BEL-VIC-001/BEL-VIC-001_1773695161_2382.png', '[\"images/productos/belleza/BEL-VIC-001/BEL-VIC-001_1773695161_2382.png\",\"images/productos/belleza/BEL-VIC-001/BEL-VIC-001_1773694991_8247.png\"]', 1, 1, '2026-03-16 21:03:45', '2026-03-16 21:06:04'),
(132, 'BEL-VIC-002', 'Perfume Vs Orchid 50 M', 'belleza', 'victorias-secret', 130.00, 'Una orquídea opulenta y exótica en un bosque encantado bajo la luz de la luna. Decadente y profunda, Very Sexy Orchid es una extensión de nuestra icónica fragancia Very Sexy. La exuberante grosella negra brilla con la frescura de los cítricos y la pimienta rosa.', 'images/productos/belleza/BEL-VIC-002/BEL-VIC-002_1773695524_8726.png', '[\"images/productos/belleza/BEL-VIC-002/BEL-VIC-002_1773695524_8726.png\",\"images/productos/belleza/BEL-VIC-002/BEL-VIC-002_1773695525_1949.png\"]', 1, 1, '2026-03-16 21:12:23', '2026-03-16 21:12:23'),
(133, 'BEL-VIC-003', 'Victoria\'s Secret Bombshell Edp 50 Ml Para Mujer', 'belleza', 'victorias-secret', 130.00, 'Bombshell 50ml edp\nEs de la familia olfativa Floral frutal para mujeres.\nLas Notas de Salida son maracuyá (fruta de la pasión), toronja (pomelo), piña, naranja tangerina y fresa; las Notas de Corazón son peonía, orquídea de vainilla, bayas rojas, jazmín y lirio de los valles (muguete); las Notas de Fondo son almizcle, notas amaderadas y musgo de roble.', 'images/productos/general/PROD/PROD_1773695929_3587.png', '[\"images/productos/general/PROD/PROD_1773695929_3587.png\",\"images/productos/general/PROD/PROD_1773695929_7961.png\"]', 1, 1, '2026-03-16 21:19:25', '2026-03-16 21:41:09'),
(134, 'PER-HOM-002', 'Scandal - Jean Paul Gaultier - 100ml EDT', 'perfumes', 'hombre', 310.00, 'Scandal Pour Homme de Jean Paul Gaultier es una fragancia de la familia olfativa Oriental Amaderada, lanzada en 2021.', 'images/productos/perfumes/PER-HOM-002/PER-HOM-002_1773696540_5850.png', '[\"images/productos/perfumes/PER-HOM-002/PER-HOM-002_1773696540_5850.png\"]', 1, 1, '2026-03-16 21:29:27', '2026-03-16 21:29:27'),
(135, 'PER-HOM-003', 'THE ICON SUPREME For Men', 'perfumes', 'hombre', 85.00, 'El perfume masculino de Antonio Banderas, The Icon Supreme EDP, presenta una fragancia amaderada aromática que equilibra frescura y profundidad. Abre con bergamota, cardamomo y pimienta rosa, seguida de un corazón con ámbar gris y musgo, y finaliza con un fondo de notas amaderadas y cítricas. Ideal para el hombre moderno que proyecta seguridad y elegancia.', 'images/productos/perfumes/PER-HOM-003/PER-HOM-003_1773696984_9689.png', '[\"images/productos/perfumes/PER-HOM-003/PER-HOM-003_1773696984_9689.png\",\"images/productos/perfumes/PER-HOM-003/PER-HOM-003_1773696986_3756.png\"]', 1, 1, '2026-03-16 21:36:45', '2026-03-16 21:36:45'),
(136, 'PER-HOM-004', 'COLORS BLACK INTENSO', 'perfumes', 'hombre', 75.00, 'Vive más tiempo. Siente más. Saca más provecho de la vida. Diviértete más. Atrévete. Confía más en ti mismo. Atrévete a vivir con más intensidad. Descubre el primer Eau de Parfum Eau de Colors para hombre. Black Intenso, el perfume con la misma personalidad que Black, pero más intenso, te invita a vivir una existencia sin límites, sin miedo y sin filtros.', 'images/productos/perfumes/PER-HOM-004/PER-HOM-004_1773697259_5991.png', '[\"images/productos/perfumes/PER-HOM-004/PER-HOM-004_1773697259_5991.png\",\"images/productos/perfumes/PER-HOM-004/PER-HOM-004_1773697261_3599.png\"]', 1, 1, '2026-03-16 21:41:03', '2026-03-16 21:41:03'),
(137, 'PER-HOM-005', 'Perfume Moschino Toy Boy 100 ml', 'perfumes', 'hombre', 160.00, 'Toy boy es la fragancia exclusiva de Moschino, que reinterpreta la elegancia con un toque de ironía. Un hombre único, apasionado, dinámico y entusiasta.\nFamilia olfativa: Picante, amaderada, ámbar.', 'images/productos/perfumes/PER-HOM-005/PER-HOM-005_1773698386_7308.png', '[\"images/productos/perfumes/PER-HOM-005/PER-HOM-005_1773698386_7308.png\",\"images/productos/perfumes/PER-HOM-005/PER-HOM-005_1773698389_6224.png\"]', 1, 1, '2026-03-16 21:59:53', '2026-03-16 21:59:53'),
(138, 'PER-HOM-006', 'Versace Eros Tradicional EDP 100 ml', 'perfumes', 'hombre', 160.00, 'Descubre la esencia de la masculinidad con ‘Versace Eros Eau De Parfum 100 ml Para Hombre’. Este perfume, lanzado en 2020, es una obra maestra de la perfumería que combina notas amaderadas y orientales, creando una fragancia intensa y fresca. Las notas de salida de limón italiano, mandarina y manzana confitada se entrelazan con el frescor de la menta, mientras que el corazón revela la sofisticación de la flor de geranio y el ámbar.', 'images/productos/perfumes/PER-HOM-006/PER-HOM-006_1773698751_9644.png', '[\"images/productos/perfumes/PER-HOM-006/PER-HOM-006_1773698751_9644.png\",\"images/productos/perfumes/PER-HOM-006/PER-HOM-006_1773698754_9418.png\"]', 1, 1, '2026-03-16 22:05:57', '2026-03-16 22:05:57'),
(139, 'PER-HOM-007', 'Eau de Toilette The Golden Secret Men Banderas 100 ml', 'perfumes', 'hombre', 55.00, 'The Golden Secret está pensada para quienes desean destacar con un aroma que combina fuerza, encanto y una masculinidad moderna que se impone con estilo propio. Desde el primer instante se percibe una energía vibrante que insinúa su carácter seductor y seguro, evolucionando hacia un corazón aromático que envuelve con intensidad elegante. Su estela final, rica y misteriosa, aporta un aura magnética que permanece con naturalidad sobre la piel. Diseñada para el hombre que busca proyectar presencia sin necesidad de esfuerzo, esta fragancia revela un equilibrio sofisticado entre frescura especiada y calidez profunda.', 'images/productos/perfumes/PER-HOM-007/PER-HOM-007_1773699076_6283.png', '[\"images/productos/perfumes/PER-HOM-007/PER-HOM-007_1773699076_6283.png\",\"images/productos/perfumes/PER-HOM-007/PER-HOM-007_1773699089_5148.png\"]', 1, 1, '2026-03-16 22:11:30', '2026-03-16 22:11:30'),
(140, 'PER-HOM-008', 'Fragancia Hugo Boss The Scent para Caballero 100 ml', 'perfumes', 'hombre', 215.00, 'La fragancia para caballero Hugo Boss The Scent, cautiva gracias a su aroma imponente y atractiva; resaltando la esencia del hombre encantador.\n\nNotas de salida: Jengibre, mandarina y bergamota\nNotas de corazón: Maninka y lavanda\nNotas de fondo: Cuero y notas amaderadas', 'images/productos/perfumes/PER-HOM-008/PER-HOM-008_1773699425_8077.png', '[\"images/productos/perfumes/PER-HOM-008/PER-HOM-008_1773699425_8077.png\",\"images/productos/perfumes/PER-HOM-008/PER-HOM-008_1773699427_8971.png\"]', 1, 1, '2026-03-16 22:17:28', '2026-03-16 22:17:28'),
(141, 'DET-FLO-005', 'Caja de Regalo Romántica con Rosas Eternas y Chocolates', 'detalles', 'flores', 60.00, 'Sorprende a esa persona especial con esta hermosa caja de regalo romántica. Incluye elegantes rosas eternas de color rosado decoradas con detalles brillantes, acompañadas de deliciosos chocolates y un accesorio especial.', 'images/productos/san_valentin____/SAN-FLO-001/SAN-FLO-001_1773712571_9416.png', '[\"images/productos/san_valentin____/SAN-FLO-001/SAN-FLO-001_1773712571_9416.png\"]', 1, 1, '2026-03-17 01:56:51', '2026-03-19 02:31:54'),
(142, 'DET-FLO-004', 'Ramo de Rosas Eternas Rosadas con Mariposa Decorativa', 'detalles', 'flores', 24.00, 'Hermoso ramo de rosas eternas en tono rosado, cuidadosamente elaborado para transmitir amor y elegancia. Cada rosa está decorada con detalles brillantes que realzan su belleza, acompañado de una delicada mariposa decorativa que simboliza transformación y amor.', 'images/productos/san_valentin____/SAN-FLO-002/SAN-FLO-002_1773712697_5594.png', '[\"images/productos/san_valentin____/SAN-FLO-002/SAN-FLO-002_1773712697_5594.png\"]', 1, 1, '2026-03-17 01:58:24', '2026-03-19 02:31:40'),
(143, 'DET-FLO-003', 'Ramo de Rosas Eternas Azules con Mariposa Dorada', 'detalles', 'flores', 15.00, 'Elegante ramo de rosas eternas en un sofisticado tono azul, ideal para expresar sentimientos profundos como admiración, respeto y amor. Cada rosa está cuidadosamente diseñada con detalles brillantes en su centro, complementada con una delicada mariposa dorada que aporta un toque único y exclusivo.', 'images/productos/san_valentin____/SAN-FLO-003/SAN-FLO-003_1773712989_8868.png', '[\"images/productos/san_valentin____/SAN-FLO-003/SAN-FLO-003_1773712989_8868.png\"]', 1, 1, '2026-03-17 02:03:11', '2026-03-19 02:31:30'),
(144, 'DET-FLO-001', 'Caja de Regalo con Rosas Amarillas, Perfume y Chocolates', 'detalles', 'flores', 42.00, 'Sorprende con esta elegante caja de regalo que combina detalles únicos y sofisticados. Incluye hermosas rosas amarillas, un delicado perfume y deliciosos chocolates, todo presentado en una moderna caja con acabado translúcido y asa decorativa.', 'images/productos/san_valentin____/SAN-FLO-004/SAN-FLO-004_1773713103_3059.png', '[\"images/productos/san_valentin____/SAN-FLO-004/SAN-FLO-004_1773713103_3059.png\"]', 1, 1, '2026-03-17 02:05:05', '2026-03-19 02:31:12'),
(145, 'DET-FLO-002', 'Caja decorativa con 4 rosas amarillas eternas', 'detalles', 'flores', 12.00, 'Caja elegante con 4 rosas amarillas decorativas elaboradas en tela satinada con detalles de cristal en el centro. Este arreglo floral es perfecto como regalo para cumpleaños, aniversarios, Día de la Madre o para decorar cualquier espacio. Las rosas mantienen su forma y color por mucho tiempo, convirtiéndose en un detalle especial y duradero. Incluye caja decorativa lista para regalar.', 'images/productos/san_valentin____/PROD/PROD_1773713237_8282.png', '[\"images/productos/san_valentin____/PROD/PROD_1773713237_8282.png\"]', 1, 1, '2026-03-17 02:07:32', '2026-03-19 02:31:19'),
(146, 'JUG-BEB-001', 'Juguete Infantil Estela Luz De Cuna Vtech', 'juguetes', 'bebé', 58.00, 'Muñeca interactiva para bebés que ayuda a relajarse antes de dormir. Incluye luz nocturna suave, canciones, melodías y sonidos de la naturaleza que calman al bebé. Sus botones suaves permiten activar diferentes funciones de música y voces. Ideal para acompañar el descanso y estimular los sentidos del bebé.', 'images/productos/juguetes/JUG-BEB-001/JUG-BEB-001_1773713421_4508.png', '[\"images/productos/juguetes/JUG-BEB-001/JUG-BEB-001_1773713421_4508.png\",\"images/productos/juguetes/JUG-BEB-001/JUG-BEB-001_1773713473_3251.webp\"]', 1, 1, '2026-03-17 02:11:14', '2026-03-17 02:11:14'),
(147, 'PEL-ANI-001', 'Peluche Oso Rosado Suave Decorativo', 'peluches', 'animales', 23.00, 'Adorable peluche de oso rosado elaborado con material suave y agradable al tacto. Perfecto como regalo para niños, cumpleaños, aniversarios o detalles especiales. Su diseño tierno y su textura suave lo hacen ideal para abrazar o decorar habitaciones.', 'images/productos/peluches/PEL-ANI-001/PEL-ANI-001_1773717196_5540.png', '[\"images/productos/peluches/PEL-ANI-001/PEL-ANI-001_1773717196_5540.png\",\"images/productos/peluches/PEL-ANI-001/PEL-ANI-001_1773717199_4499.png\"]', 2, 1, '2026-03-17 03:12:17', '2026-03-17 03:13:21'),
(148, 'BEL-VIC-004', 'Victoria’s Secret Love Spell Set', 'belleza', 'victorias-secret', 50.00, 'Set de regalo de Victoria’s Secret Love Spell, uno de los aromas más clásicos y populares de la marca.', 'images/productos/belleza/BEL-VIC-004/BEL-VIC-004_1773717354_8486.png', '[\"images/productos/belleza/BEL-VIC-004/BEL-VIC-004_1773717354_8486.png\",\"images/productos/belleza/BEL-VIC-004/BEL-VIC-004_1773717384_9010.png\"]', 1, 1, '2026-03-17 03:16:27', '2026-03-17 03:16:27'),
(149, 'BEL-VIC-005', 'Victoria’s Secret, Aqua Kiss, Set de regalo, Crema y Splash de 75ml', 'belleza', 'victorias-secret', 50.00, 'Celebra la colección que te celebra. Para cada momento y cada faceta de ti, descubre aromas únicos que lo abarcan todo.\n\nBESO AGUA\n\nDescripción de la fragancia\nTipo: Fresco\nAguas frescas. Margaritas brillantes. ¡Chapotea!', 'images/productos/belleza/BEL-VIC-005/BEL-VIC-005_1773717572_8690.png', '[\"images/productos/belleza/BEL-VIC-005/BEL-VIC-005_1773717572_8690.png\",\"images/productos/belleza/BEL-VIC-005/BEL-VIC-005_1773717573_6575.png\"]', 1, 1, '2026-03-17 03:19:37', '2026-03-17 03:19:37'),
(150, 'BEL-VIC-006', 'Mini Fragancia Y Crema De Bolsillo Victorias Secret', 'belleza', 'victorias-secret', 50.00, 'Para los amantes de las brumas y lociones. Descubre dos de nuestras fragancias más vendidas en tamaño mini. El set incluye Velvet Petals y Pure Seduction. El set incluye: una bruma y una loción mini de cada fragancia. Velvet Petals: Lush Blooms. Almond Glaze', 'images/productos/belleza/BEL-VIC-006/BEL-VIC-006_1773717850_3205.png', '[\"images/productos/belleza/BEL-VIC-006/BEL-VIC-006_1773717850_3205.png\"]', 1, 1, '2026-03-17 03:25:09', '2026-03-17 03:25:09');
