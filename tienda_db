--
-- Disparadores `products`
--
DELIMITER $$
CREATE TRIGGER `products_after_update` AFTER UPDATE ON `products` FOR EACH ROW BEGIN
    IF OLD.name != NEW.name OR OLD.price != NEW.price OR OLD.stock != NEW.stock THEN
        INSERT INTO audit_log (action, entity_type, entity_id, description)
        VALUES ('UPDATE', 'PRODUCT', NEW.id, CONCAT('Producto modificado: ', NEW.name));
    END IF;
END
$$
DELIMITER ;
DELIMITER $$
CREATE TRIGGER `products_before_delete` BEFORE DELETE ON `products` FOR EACH ROW BEGIN
    INSERT INTO audit_log (action, entity_type, entity_id, description)
    VALUES ('DELETE', 'PRODUCT', OLD.id, CONCAT('Producto eliminado: ', OLD.name));
END
$$
DELIMITER ;

