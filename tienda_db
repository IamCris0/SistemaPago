CREATE ALGORITHM=UNDEFINED DEFINER=`maweweco_cris`@`45.189.57.40` SQL SECURITY DEFINER VIEW `attendance_report`  AS SELECT `e`.`employee_code` AS `employee_code`, concat(`e`.`first_name`,' ',`e`.`last_name`) AS `employee_name`, `e`.`position` AS `position`, `e`.`department` AS `department`, `a`.`date` AS `date`, `a`.`check_in` AS `check_in`, `a`.`check_out` AS `check_out`, `a`.`total_hours` AS `total_hours`, `a`.`status` AS `status`, CASE WHEN `a`.`check_in` > `ws`.`start_time` THEN 'TARDE' ELSE 'A TIEMPO' END AS `punctuality` FROM ((`attendance` `a` join `employees` `e` on(`a`.`employee_id` = `e`.`id`)) left join `work_schedules` `ws` on(`e`.`id` = `ws`.`employee_id` and dayname(`a`.`date`) = case `ws`.`day_of_week` when 'lunes' then 'Monday' when 'martes' then 'Tuesday' when 'miercoles' then 'Wednesday' when 'jueves' then 'Thursday' when 'viernes' then 'Friday' when 'sabado' then 'Saturday' when 'domingo' then 'Sunday' end)) ;

